@using System.Text.Json
@using System.Linq;
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolHub</title>

    <script type="importmap"></script>
    <link href="~/select2/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolHub.styles.css" asp-append-version="true" />
    <link href="~/sweetalert2/sweetalert2.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <div class="layout">

        @await Component.InvokeAsync("Sidebar")

  
        <!-- Main -->
        <div class="main-content">

            <!-- Top Navbar -->
            <header>

                <nav class="navbar custom-navbar">

                    <div class="container-fluid">

                        @{
                            var name = Context.User?.Identity?.Name;
                        }

                        @if (name == null)
                        {
                            <div class="ms-auto">

                                <a class="btn btn-light me-2"
                                   asp-controller="User"
                                   asp-action="Login">
                                    ورود
                                </a>

                                <a class="btn btn-outline-light"
                                   asp-controller="User"
                                   asp-action="SignIn">
                                    ثبت نام
                                </a>

                            </div>
                        }
                        else
                        {
                            <div class="dropdown ms-auto">

                                <a class="btn btn-light dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-person-circle"></i>
                                    @name

                                </a>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">

                                            <i class="bi bi-box-arrow-right"></i>
                                            خروج

                                        </a>
                                    </li>

                                </ul>

                            </div>
                        }

                    </div>

                </nav>

            </header>

            <!-- Page Content -->
            <main class="container-fluid py-4">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/sweetalert2/sweetalert2.all.js"></script>
    <script src="~/select2/js/i18n/fa.min.js"></script>
    <script src="~/select2/js/select2.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (TempData["Success"] is string success)
    {
        <script>
                Swal.fire({
                    icon: 'success',
                    title: 'موفق',
                    text: @Html.Raw(JsonSerializer.Serialize(success)),
                    confirmButtonText: 'باشه'
                });
        </script>
    }

    @if (TempData["Eror"] is string eror)
    {
        <script>
                window.onload = function () {
                    Swal.fire({
                        icon: "error",
                        title: "خطا",
                        text: '@TempData["Success"]',
                        text: @Html.Raw(JsonSerializer.Serialize(eror)),
                    });
                };

                                            
                            
        </script>
    }
    }

</body>
</html>