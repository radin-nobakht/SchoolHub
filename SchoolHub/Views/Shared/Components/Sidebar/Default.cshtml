@model MenuViewModel


<aside class="sidebar">


    <div class="sidebar-header">

        <i class="bi bi-mortarboard-fill"></i>

        <span>
            SchoolHub
        </span>

    </div>



    <ul class="sidebar-menu">


        <li>


            <div class="sidebar-item">


                <a asp-controller="School"
                   asp-action="SchoolPage">

                    <i class="bi bi-mortarboard-fill"></i>

                    <span>
                        مدارس
                    </span>

                </a>


                <a href="#schoolsMenu"
                   data-bs-toggle="collapse"
                   class="collapse-toggle">

                    <i class="bi bi-chevron-left collapse-icon"></i>

                </a>


            </div>



            <li class="sidebar-section">

                <a href="#managerSchools"
                   data-bs-toggle="collapse"
                   class="sidebar-link">

                    <i class="bi bi-person-badge"></i>

                    <span>
                        مدیر
                    </span>

                    <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                </a>

                <ul id="managerSchools"
                    class="collapse submenu">

                    @{
                        int index = 0;
                    }

                    @foreach (var type in Model.MangerSchool)
                    {
                        index++;

                        <li>

                            <a href="#manager-type-@index"
                               data-bs-toggle="collapse"
                               class="sidebar-link">

                                <i class="bi bi-building"></i>

                                <span>
                                    @type.SchoolType
                                </span>

                                <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                            </a>

                            <ul id="manager-type-@index"
                                class="collapse submenu">

                                @foreach (var school in type.Schools)
                                {
                                    <li>

                                        <a asp-controller="School"
                                           asp-action="SchoolInfo"
                                           asp-route-id="@school.Id"
                                           asp-route-mode="manager">

                                            <i class="bi bi-house"></i>

                                            <span>
                                                @school.Name
                                            </span>

                                        </a>

                                    </li>
                                }

                            </ul>

                        </li>
                    }

                </ul>

            </li>
            <li class="sidebar-section">

                <a href="#teacherSchools"
                   data-bs-toggle="collapse"
                   class="sidebar-link">

                    <i class="bi bi-person-workspace"></i>

                    <span>
                        معلم
                    </span>

                    <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                </a>

                <ul id="teacherSchools"
                    class="collapse submenu">

                    @{
                        index = 0;
                    }

                    @foreach (var type in Model.TeacherSchool)
                    {
                        index++;

                        <li>

                            <a href="#teacher-type-@index"
                               data-bs-toggle="collapse"
                               class="sidebar-link">

                                <i class="bi bi-building"></i>

                                <span>
                                    @type.SchoolType
                                </span>

                                <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                            </a>

                            <ul id="teacher-type-@index"
                                class="collapse submenu">

                                @foreach (var school in type.Schools)
                                {
                                    <li>

                                        <a asp-controller="School"
                                           asp-action="SchoolInfo"
                                           asp-route-id="@school.Id"
                                           asp-route-mode="teacher">

                                            <i class="bi bi-house"></i>

                                            <span>
                                                @school.Name
                                            </span>

                                        </a>

                                    </li>
                                }

                            </ul>

                        </li>
                    }

                </ul>

            </li>

        </li>


    </ul>


</aside>