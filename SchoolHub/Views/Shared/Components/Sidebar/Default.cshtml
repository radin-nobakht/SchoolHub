@model MenuViewModel

<aside class="sidebar">

    <!-- ==================== Sidebar Header ==================== -->

    <div class="sidebar-header">

                <span>
            SchoolHub
        </span>

    </div>


    <!-- ==================== Sidebar Menu ==================== -->

    <ul class="sidebar-menu">

        <!-- ==================== Schools ==================== -->

        <li class="sidebar-section">

            <a href="#schoolsMenu"
               data-bs-toggle="collapse"
               class="sidebar-link">

            <i class="bi bi-building-fill"></i>                <span>
                    مدارس
                </span>

                <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

            </a>


            <ul id="schoolsMenu"
                class="collapse submenu">


                <!-- ==================== Manager ==================== -->

                <li class="sidebar-section">

                    <a href="#managerSchools"
                       data-bs-toggle="collapse"
                       class="sidebar-link">

                        <i class="bi bi-person-badge"></i>

                        <span>
                            مدیر
                        </span>

                        <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                    </a>


                    <ul id="managerSchools"
                        class="collapse submenu">

                        @{
                            int managerIndex = 0;
                        }

                        @foreach (var type in Model.MangerSchool)
                        {
                            managerIndex++;

                            <li>

                                <a href="#manager-type-@managerIndex"
                                   data-bs-toggle="collapse"
                                   class="sidebar-link">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        @type.SchoolType
                                    </span>

                                    <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                                </a>


                                <ul id="manager-type-@managerIndex"
                                    class="collapse submenu">

                                    @foreach (var school in type.Schools)
                                    {
                                        <li>

                                            <a asp-action="SchoolInfo"
                                           asp-controller="SchoolManager"
                                               asp-route-schoolId="@school.Id"
                                               class="sidebar-link">

                                                <i class="bi bi-house"></i>

                                                <span>
                                                    @school.Name
                                                </span>

                                            </a>

                                        </li>
                                    }

                                </ul>

                            </li>
                        }

                    </ul>

                </li>


                <!-- ==================== Teacher ==================== -->

                <li class="sidebar-section">

                    <a href="#teacherSchools"
                       data-bs-toggle="collapse"
                       class="sidebar-link">

                        <i class="bi bi-person-workspace"></i>

                        <span>
                            معلم
                        </span>

                        <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                    </a>


                    <ul id="teacherSchools"
                        class="collapse submenu">

                        @{
                            int teacherIndex = 0;
                        }

                        @foreach (var type in Model.TeacherSchool)
                        {
                            teacherIndex++;

                            <li>

                                <a href="#teacher-type-@teacherIndex"
                                   data-bs-toggle="collapse"
                                   class="sidebar-link">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        @type.SchoolType
                                    </span>

                                    <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                                </a>


                                <ul id="teacher-type-@teacherIndex"
                                    class="collapse submenu">

                                    @foreach (var school in type.Schools)
                                    {
                                        <li>

                                            <a asp-action="SchoolInfo"
                                               asp-controller="SchoolTeacher"
                                               asp-route-schoolId="@school.Id"
                                               class="sidebar-link">

                                                <i class="bi bi-house"></i>

                                                <span>
                                                    @school.Name
                                                </span>

                                            </a>

                                        </li>
                                    }

                                </ul>

                            </li>
                        }

                    </ul>

                </li>


                <!-- ==================== Student ==================== -->

                <li class="sidebar-section">

                    <a href="#studentSchools"
                       data-bs-toggle="collapse"
                       class="sidebar-link">

                        <i class="bi bi-person-standing"></i>

                        <span>
                            دانش‌آموز
                        </span>

                        <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                    </a>


                    <ul id="studentSchools"
                        class="collapse submenu">

                        @{
                            int studentIndex = 0;
                        }

                        @foreach (var type in Model.StudentSchool)
                        {
                            studentIndex++;

                            <li>

                                <a href="#student-type-@studentIndex"
                                   data-bs-toggle="collapse"
                                   class="sidebar-link">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        @type.SchoolType
                                    </span>

                                    <i class="bi bi-chevron-left ms-auto collapse-icon"></i>

                                </a>


                                <ul id="student-type-@studentIndex"
                                    class="collapse submenu">

                                    @foreach (var school in type.Schools)
                                    {
                                        <li>

                                        <a asp-action="StudentInfo"
                                               asp-controller="SchoolStudent"
                                               asp-route-schoolId="@school.Id"
                                               class="sidebar-link">

                                                <i class="bi bi-mortarboard-fill"></i>
                                                <span>
                                                    @school.Name
                                                </span>

                                            </a>

                                        </li>
                                    }

                                </ul>

                            </li>
                        }

                    </ul>

                </li>

            </ul>

        </li>

    </ul>

</aside>