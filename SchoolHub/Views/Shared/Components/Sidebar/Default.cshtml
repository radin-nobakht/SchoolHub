@model List<SchoolHub.Dto.School.SchoolBarDto>


<aside class="sidebar">


    <div class="sidebar-header">

        <i class="bi bi-mortarboard-fill"></i>

        <span>
            SchoolHub
        </span>

    </div>



    <ul class="sidebar-menu">


        <li>


            <div class="sidebar-item">


                <a asp-controller="School"
                   asp-action="SchoolPage">

                    <i class="bi bi-mortarboard-fill"></i>

                    <span>
                        مدارس
                    </span>

                </a>


                <a href="#schoolsMenu"
                   data-bs-toggle="collapse"
                   class="collapse-toggle">

                    <i class="bi bi-chevron-left collapse-icon"></i>

                </a>


            </div>




            <ul id="schoolsMenu"
                class="collapse submenu">


                @{
                    int index = 0;
                }


                @foreach (var type in Model)
                {
                    index++;


                    <li>


                        <a href="#type-@index"
                           data-bs-toggle="collapse"
                           class="sidebar-link">


                            <i class="bi bi-building"></i>


                            <span>
                                @type.SchoolType
                            </span>


                            <i class="bi bi-chevron-left ms-auto collapse-icon"></i>


                        </a>




                        <ul id="type-@index"
                            class="collapse submenu">



                            @foreach (var school in type.Schools)
                            {
                                <li>

                                    <a asp-controller="School"
                                       asp-action="SchoolInfo"
                                       asp-route-id="@school.Id">


                                        <i class="bi bi-house"></i>


                                        <span>
                                            @school.Name
                                        </span>


                                    </a>


                                </li>
                            }



                        </ul>


                    </li>
                }



            </ul>


        </li>


    </ul>


</aside>