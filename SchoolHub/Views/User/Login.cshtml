@{
    Layout = null;
}
<link href="~/css/loginorsignincss.css" rel="stylesheet" />


<div class="login-container">

    <div class="card">

        <h1>ورود</h1>

        <p class="subtitle">
            برای ورود به حساب کاربری اطلاعات خود را وارد کنید.
        </p>

        <form action="LogIn" method="post">

            <div class="input-group">
                <label>کد ملی</label>
                <input type="text" required name="nationalIdNumber"
                       placeholder="کد ملی خود را وارد کنید">
            </div>

            <div class="input-group">
                <label>کد</label>
                <input type="password" required name="code"
                       placeholder="کد خود را وارد کنید">
            </div>

            <div class="checkbox">

                <div>
                    <input type="checkbox" id="student" name="isStudent">
                    <label for="student">
                        دانش آموز هستم
                    </label>
                </div>


            </div>

            <p class="text-danger fw-bold"> @ViewBag.Eror</p>

            <button type="submit" class="btn">
                ورود
            </button>

        </form>

        <div class="divider">
            <span>یا</span>
        </div>

        <a href="Register.html" class="link-btn">
            حساب کاربری ندارید؟ ثبت نام کنید
        </a>

    </div>

</div>