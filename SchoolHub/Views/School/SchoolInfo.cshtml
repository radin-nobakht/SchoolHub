@model SchoolHub.Dto.School.AllDatailAboutSchool

<link href="c:\users\radin\source\repos\schoolhub\schoolhub\views\school\schoolinfo.cshtml.css" rel="stylesheet" />
<div class="container py-5">

    <div class="school-card">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <div class="school-title">
                    @Model.School.Name
                </div>

                <small class="text-muted">
                    اطلاعات کامل مدرسه
                </small>
            </div>

            <a asp-action="UpdateSchool"
               asp-route-id="@Model.School.Id"
               class="btn btn-primary">
                ویرایش مدرسه
            </a>

        </div>


        <div class="row mt-4 g-3">

            <div class="col-md-4">
                <div class="info-box">
                    <span>🏙 استان</span>
                    <h5>@Model.School.Province</h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>🏙 شهر</span>
                    <h5>@Model.School.City</h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>📍 منطقه</span>
                    <h5>@Model.School.District</h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>👨‍💼 مدیر مدرسه</span>
                    <h5>
                        @Model.School.MangerFullName
                    </h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>🏫 نوع مدرسه</span>
                    <h5>@Model.School.Type</h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>👥 جنسیت</span>
                    <h5>@Model.School.Gender</h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>⏰ شیفت</span>
                    <h5>@Model.School.Shift</h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>📚 مقطع تحصیلی</span>
                    <h5>@Model.School.EducationLevel</h5>
                </div>
            </div>


            <div class="col-md-4">
                <div class="info-box">
                    <span>🎓 دوره تحصیلی</span>
                    <h5>@Model.School.EducationPeriod</h5>
                </div>
            </div>

        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center classes-title">

        <span>

            کلاس‌های مدرسه

        </span>

        <button type="button"
                class="btn btn-success"
                id="btnOpenAddClass">
            افزودن کلاس
        </button>

    </div>

    <div class="row g-4">

        @foreach (var item in Model.Classes)
        {

            <div class="col-lg-4 col-md-6 class-item">
                <div class="class-card">

                    <div class="class-name">

                        @item.Name

                    </div>

                    <div class="class-grade">

                        پایه @item.Grade

                    </div>

                    <div class="buttons">

                        <a href="#" class="btn btn-outline-primary btn-sm w-100">

                            مشاهده

                        </a>

                        <a href="#" class="btn btn-outline-warning btn-sm w-100">

                            ویرایش

                        </a>

                        <button class="btn btn-outline-danger btn-sm w-100 btnDelete"
                                data-id="@item.Id"
                                data-grade="@item.Grade"
                                data-subject="@item.Name">
                            حذف
                        </button>

                    </div>

                </div>

            </div>

        }

    </div>

</div>
<partial name="_AddClass" model="Model.School.Id" />
