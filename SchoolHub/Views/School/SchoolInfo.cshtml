@model SchoolHub.Dto.School.AllDatailAboutSchool

<link href="~/css/schoolInfoCss.css" rel="stylesheet" />
    <div class="container py-5">

        <div class="school-card">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <div class="school-title">

                        @Model.School.SchoolName

                    </div>

                    <small class="text-muted">

                        اطلاعات کامل مدرسه

                    </small>

                </div>

                <a href="#" class="btn btn-primary">

                    ویرایش مدرسه

                </a>

            </div>

            <div class="row mt-4 g-3">

                <div class="col-md-4">

                    <div class="info-box">

                        <span>🏙 شهر</span>

                        <h5>@Model.School.SchoolCity</h5>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-box">

                        <span>📍 منطقه</span>

                        <h5>@Model.School.SchoolRegion</h5>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-box">

                        <span>👨‍💼 مدیر مدرسه</span>

                        <h5>@(Model.Manager.Name+" "+Model.Manager.LastName)</h5>

                    </div>

                </div>

            </div>

        </div>


        <div class="d-flex justify-content-between align-items-center classes-title">

            <span>

                کلاس‌های مدرسه

            </span>

            <a href="#" class="btn btn-success">

                افزودن کلاس

            </a>

        </div>

        <div class="row g-4">

            @foreach (var item in Model.Classes)
            {

                <div class="col-lg-4 col-md-6">

                    <div class="class-card">

                        <div class="class-name">

                            @item.classes.ClassSubject

                        </div>

                        <div class="class-grade">

                            پایه @item.classes.Grade

                        </div>

                        <hr>

                        <div class="teacher">

                            👨‍🏫@(item.Teacher.Name + " "+item.Teacher.LastName)

                        </div>

                      

                        <div class="buttons">

                            <a href="#" class="btn btn-outline-primary btn-sm w-100">

                                مشاهده

                            </a>

                            <a href="#" class="btn btn-outline-warning btn-sm w-100">

                                ویرایش

                            </a>

                            <a href="#" class="btn btn-outline-danger btn-sm w-100">

                                حذف

                            </a>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>

