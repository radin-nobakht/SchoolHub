@using System.Text.Json
@model List<SchoolListItemViewModel>



<div class="container mt-4">

    <div class="row g-4">

        @if (Model.Any(x => x.IsManager))
        {
            <button type="button"
                    class="btn btn-success"
                    id="btnOpenAddSchool">
                افزودن مدرسه
            </button>
        }

        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">

                <div class="school-card">

                    <div class="school-icon">
                        🏫
                    </div>

                    <h4>@item.School.Name</h4>

                    <p>
                        <strong>استان:</strong>
                        @item.School.Province
                    </p>

                    <p>
                        <strong>شهر:</strong>
                        @item.School.City
                    </p>

                    <p>
                        <strong>منطقه:</strong>
                        @item.School.District
                    </p>

                    <div class="d-flex gap-2 mt-3">

                        @if (item.IsManager)
                        {
                            <a asp-action="SchoolInfo"
                               asp-controller="SchoolManager"
                               asp-route-schoolId="@item.School.Id"
                               class="btn btn-primary flex-fill">

                                👨‍💼  مدیریت

                            </a>
                        }

                        @if (item.IsTeacher)
                        {
                            <a asp-action="SchoolInfo"
                               asp-controller="SchoolTeacher"
                               asp-route-schoolId="@item.School.Id"
                               class="btn btn-success flex-fill">

                                👨‍🏫  معلم
                            </a>
                        }

                        @if (item.IsStudent)
                        {
                            <a asp-action="ClassInfo"
                               asp-controller="SchoolStudent"
                               asp-route-schoolId="@item.School.Id"
                               class="btn btn-warning flex-fill">

                                👨‍🎓  دانش اموز

                            </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<partial name="_AddSchool" />

