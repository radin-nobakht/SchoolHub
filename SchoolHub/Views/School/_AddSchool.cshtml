<div class="modal fade" id="addSchoolModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content school-modal">

            <div class="modal-header school-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-building-add me-2"></i>
                    اضافه کردن مدرسه
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <form action="/School/AddSchool" method="post">

                <div class="modal-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">نام مدرسه</label>

                            <input type="text"
                                   class="form-control"
                                   name="name"
                                   required
                                   placeholder="مثلاً دبیرستان نمونه">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">استان</label>

                            <select id="provinceGeneral"
                                    class="form-select select2"
                                    name="garadeId"
                                    required
                                    onchange="city()">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">شهر</label>

                            <select id="schoolCity"
                                    class="form-select select2"
                                    name="cityId"
                                    required
                                    onchange="district()">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3" id="District">
                            <label class="form-label">منطقه</label>

                            <select id="schoolDistrict"
                                    class="form-select select2"
                                    name="districtId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">نوع مدرسه</label>

                            <select id="typeGeneral"
                                    class="form-select select2"
                                    name="TypeGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">شیفت</label>

                            <select id="shiftGeneral"
                                    class="form-select select2"
                                    name="ShiftGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">مقطع</label>

                            <select id="educationLevelGeneral"
                                    class="form-select select2"
                                    name="EducationLevelGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">دوره</label>

                            <select id="educationPeriodGeneral"
                                    class="form-select select2"
                                    name="EducationPeriodGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">جنسیت</label>

                            <select id="genderGeneral"
                                    class="form-select select2"
                                    name="GenderGeneralId">
                            </select>
                        </div>

                    </div>

                    @if (ViewBag.Eror != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @ViewBag.Eror
                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button class="btn btn-light border"
                            data-bs-dismiss="modal"
                            type="button">
                        انصراف
                    </button>

                    <button class="btn btn-primary px-4"
                            type="submit">
                        <i class="bi bi-check-circle ms-1"></i>
                        ثبت مدرسه
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>