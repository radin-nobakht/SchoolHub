@{
    Layout = null;
}
<link href="~/css/loginorsignincss.css" rel="stylesheet" />
<link href="c:\users\radin\source\repos\schoolhub\schoolhub\wwwroot\css\site.css" rel="stylesheet" />
<div class="login-container">

    <div class="card">

        <h1>ثبت نام</h1>

        <p class="subtitle">
            اطلاعات خود را وارد کنید تا حساب کاربری ایجاد شود.
        </p>

        <form action="SignIn" method="post">

            <div class="input-group">
                <label>نام</label>
                <input type="text" required name="name"
                       placeholder="نام">
            </div>

            <div class="input-group">
                <label>نام خانوادگی</label>
                <input type="text" required name="LastName"
                       placeholder="نام خانوادگی">
            </div>

            <div class="input-group">
                <label>کد ملی</label>
                <input type="text" required name="nationalIdNumber"
                       placeholder="کد ملی">
            </div>
            <div class="input-group">
                <label>رمز</label>
                <input type="text" required name="Password"
                       placeholder=" رمز">
            </div>

            <div class="checkbox">

                <div>
                    <input type="checkbox" id="student">
                    <label for="student">
                        دانش آموز هستم
                    </label>
                </div>

            </div>
            <p class="text-danger fw-bold"> @ViewBag.Eror</p>

            <button type="submit" class="btn">
                ثبت نام
            </button>

        </form>

        <div class="divider">
            <span>یا</span>
        </div>

        <a href="Login" class="link-btn">
            قبلاً ثبت نام کرده‌اید؟ وارد شوید
        </a>

    </div>

</div>
