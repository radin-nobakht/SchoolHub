@model int
<div class="modal fade" id="updateSchoolModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content school-modal">

            <div class="modal-header school-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-building-gear me-2"></i>
                    ویرایش مدرسه
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <form action="/SchoolManager/UpdateSchool" method="post">

                <div class="modal-body">

                    <input type="hidden"
                           id="updateSchoolId"
                           name="schoolId"
                           value="@Model">

                    <input type="hidden"id="cityId" />

                    <input type="hidden"id="DistrictId" />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">نام مدرسه</label>

                            <input type="text"
                                   id="updateSchoolName"
                                   class="form-control"
                                   value="@ViewBag.Name"
                                   name="name"
                                   required
                                   placeholder="مثلاً دبیرستان نمونه">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">کد ملی مدیر</label>

                            <input type="text"
                                   id="managerNationalId"
                                   class="form-control"
                                   name="managerNationalId"
                                   inputmode="numeric"
                                   maxlength="10"
                                   minlength="10"
                                   required
                                   placeholder="کد ملی ۱۰ رقمی مدیر">
                            <div id="managerSearchResult" class="mt-1"></div>

                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">استان</label>

                            <select id="updateProvinceGeneral"
                                    class="form-select select2"
                                    required
                                    onchange="cityForUpdateSchool()">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">شهر</label>

                            <select id="updateSchoolCity"
                                    class="form-select select2"
                                    name="cityId"
                                    required
                                    onchange="districtForUpdateSchool()">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3" id="UpdateDistrict">
                            <label class="form-label">منطقه</label>

                            <select id="updateSchoolDistrict"
                                    class="form-select select2"
                                    name="districtId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">نوع مدرسه</label>

                            <select id="updateTypeGeneral"
                                    class="form-select select2"
                                    name="typeGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">شیفت</label>

                            <select id="updateShiftGeneral"
                                    class="form-select select2"
                                    name="shiftGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">مقطع</label>

                            <select id="updateEducationLevelGeneral"
                                    class="form-select select2"
                                    name="educationLevelGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">دوره</label>

                            <select id="updateEducationPeriodGeneral"
                                    class="form-select select2"
                                    name="educationPeriodGeneralId">
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">جنسیت</label>

                            <select id="updateGenderGeneral"
                                    class="form-select select2"
                                    name="genderGeneralId">
                            </select>
                        </div>

                    </div>

                    @if (ViewBag.Eror != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @ViewBag.Eror
                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button class="btn btn-light border"
                            data-bs-dismiss="modal"
                            type="button">
                        انصراف
                    </button>

                    <button class="btn btn-primary px-4"
                            type="submit">
                        <i class="bi bi-check-circle ms-1"></i>
                        ذخیره تغییرات
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>