@model int
<div class="modal fade" id="addClassModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">اضافه کردن کلاس</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-controller="SchoolManager"
                  asp-action="AddClass"
                  method="post">

                <div class="modal-body">

                    <input type="hidden"
                           name="schoolId"
                           id="schoolId"
                           value="@Model" />

                    <div class="mb-3">
                        <label class="form-label">نام</label>
                        <input type="text"
                               class="form-control"
                               name="name"
                               required
                               placeholder="نام کلاس خود را وارد کنید">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">پایه</label>

                        <select id="gradeGeneral"
                                class="form-select select2"
                                name="gradeGeneralId"
                                required
                                onchange="Major()">
                        </select>
                    </div>


                    <div class="col-md-6 mb-3" id="major">
                        <label class="form-label">رشته</label>

                        <select id="majorGeneral"
                                class="form-select select2"
                                name="majorGeneralId">
                        </select>
                    </div>


                    <p class="text-danger fw-bold">
                        @ViewBag.Error
                    </p>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        انصراف
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        ثبت
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>