@model int

<div class="modal fade assign-teacher-modal"
     id="updateTeacherModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">

                <div class="modal-title-wrapper">

                    <div class="modal-icon">
                        👨‍🏫
                    </div>

                    <div>
                        <h5 class="modal-title">
                            ویرایش درس‌های معلم
                        </h5>

                        <span class="modal-subtitle">
                            درس‌های معلم را اضافه یا حذف کنید
                        </span>
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form action="/SchoolManager/UpdateTeacher"
                  method="post">

                <div class="modal-body">

                    <input type="hidden"
                           name="classId"
                           id="classId"
                           value="@Model" />

                    <input type="hidden"
                           name="teacherUserId"
                           id="teacherUserId"
                           value="" />

                    <!-- Subjects -->
                    <div class="form-group">

                        <label class="form-label">
                            درس‌ها
                        </label>

                        <select id="teacherSubjectsUpdate"
                                name="SubjectIds"
                                class="form-select select2 custom-select"
                                multiple
                                required>
                        </select>

                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="form-error">
                            <span>⚠️</span>
                            <span>@ViewBag.Error</span>
                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light modal-cancel-btn"
                            data-bs-dismiss="modal">
                        انصراف
                    </button>

                    <button type="submit"
                            class="btn btn-primary modal-submit-btn">
                        <span>✓</span>
                        ذخیره تغییرات
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>