@model SchoolHub.Dto.School.AllDatailAboutSchool


@{
    ViewData["Title"] = "پنل مدیریت";
    ViewBag.Name = Model?.School?.Name;
}

<div class="manager-school-page">

    <div class="school-card">

        <div class="school-header">

            <div class="school-header-info">

                <div class="school-icon">
                    🏫
                </div>

                <div>

                    <div class="school-title-row">

                        <div class="school-title">
                            @Model.School.Name
                        </div>

                        <button type="button"
                                class="btn btn-outline-primary btn-sm btn-edit-school"
                                id="btnEditSchool"
                                data-id="@Model.School.Id">
                            ✏️ ویرایش
                        </button>

                    </div>

                    <div class="school-subtitle">
                        اطلاعات مدرسه
                    </div>

                </div>

            </div>

        </div>


        <div class="school-info-grid">

            <div class="info-box">
                <div class="info-icon">🏙️</div>
                <div class="info-content">
                    <span>استان</span>
                    <h5>@Model.School.Province</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">🌆</div>
                <div class="info-content">
                    <span>شهر</span>
                    <h5>@Model.School.City</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">📍</div>
                <div class="info-content">
                    <span>منطقه</span>
                    <h5>@Model.School.District</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">👨‍💼</div>
                <div class="info-content">
                    <span>مدیر مدرسه</span>
                    <h5>@Model.School.MangerFullName</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">🏫</div>
                <div class="info-content">
                    <span>نوع مدرسه</span>
                    <h5>@Model.School.Type</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">👥</div>
                <div class="info-content">
                    <span>جنسیت</span>
                    <h5>@Model.School.Gender</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">⏰</div>
                <div class="info-content">
                    <span>شیفت</span>
                    <h5>@Model.School.Shift</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">📚</div>
                <div class="info-content">
                    <span>مقطع</span>
                    <h5>@Model.School.EducationLevel</h5>
                </div>
            </div>

            <div class="info-box">
                <div class="info-icon">🎓</div>
                <div class="info-content">
                    <span>دوره</span>
                    <h5>@Model.School.EducationPeriod</h5>
                </div>
            </div>

        </div>

    </div>


    <div class="classes-header">

        <div class="classes-heading">

            <div class="classes-icon">
                📚
            </div>

            <div>
                <h3>کلاس‌های مدرسه</h3>
                <span>کلاس‌های ثبت شده در مدرسه</span>
            </div>

        </div>

        <button type="button"
                class="btn btn-success add-class-btn"
                id="btnOpenAddClass">

            ＋ افزودن کلاس

        </button>

    </div>


    @if (Model.Classes is not null && Model.Classes.Any())
    {
        <div class="row g-2">

            @foreach (var item in Model.Classes)
            {
                <div class="col-xl-4 col-lg-6 col-md-6 class-item">

                    <div class="class-card">

                        <div class="class-card-header">

                            <div class="class-card-icon">
                                🎓
                            </div>

                            <div class="class-name">
                                @item.Name
                            </div>

                        </div>


                        <div class="class-details">

                            <div class="class-detail">
                                <span>پایه:</span>
                                <strong>@item.Grade</strong>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Major))
                            {
                                <div class="class-detail">
                                    <span>رشته:</span>
                                    <strong>@item.Major</strong>
                                </div>
                            }

                        </div>


                        <div class="buttons">

                            <a asp-controller="SchoolManager"
                               asp-action="ClassInfo"
                               asp-route-classId="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                👁 مشاهده
                            </a>

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm btnDelete"
                                    data-id="@item.Id">
                                🗑 حذف
                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-classes">

            <div class="empty-icon">
                📚
            </div>

            <h4>
                هنوز کلاسی ثبت نشده است
            </h4>

            <p>
                برای این مدرسه هنوز هیچ کلاسی ایجاد نشده است.
            </p>

            <button type="button"
                    class="btn btn-success"
                    id="btnOpenAddClass">

                ＋ افزودن اولین کلاس

            </button>

        </div>
    }

</div>


<partial name="_AddClass.cshtml" model="@Model.School.Id" />
<partial name="_UpdateSchool.cshtml" model="@Model.School.Id" />


@section Scripts {

    <script>

        // =========================
        // حذف کلاس
        // =========================

        $(document).on("click", ".btnDelete", function () {

            const button = $(this);
            const classId = button.data("id");
            const classCard = button.closest(".class-card");

            Swal.fire({
                title: "حذف کلاس؟",
                text: "آیا مطمئن هستید که می‌خواهید این کلاس را حذف کنید؟",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "بله، حذف کن",
                cancelButtonText: "لغو",
                reverseButtons: true
            }).then((result) => {

                if (!result.isConfirmed)
                    return;

                $.ajax({

                    url: "/SchoolManager/DeleteClass",
                    type: "POST",

                    data: {
                        classId: classId
                    },

                    success: function (data) {

                        if (data) {

                            Swal.fire({
                                title: "حذف شد",
                                text: "کلاس با موفقیت حذف شد.",
                                icon: "success",
                                timer: 1500,
                                showConfirmButton: false
                            });

                            classCard.fadeOut(300, function () {
                                $(this).remove();
                            });

                        }
                        else {

                            Swal.fire({
                                title: "خطا",
                                text: "حذف کلاس انجام نشد.",
                                icon: "error",
                                confirmButtonText: "باشه"
                            });

                        }

                    },

                    error: function () {

                        Swal.fire({
                            title: "خطا",
                            text: "در هنگام حذف کلاس مشکلی پیش آمد.",
                            icon: "error",
                            confirmButtonText: "باشه"
                        });

                    }

                });

            });

        });

    </script>

}
