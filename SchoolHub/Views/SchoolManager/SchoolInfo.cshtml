@model SchoolHub.Dto.School.AllDatailAboutSchool

@{
    ViewData["Title"] = "پنل مدیریت";
    ViewBag.Name = Model?.School?.Name;
}

<div class="manager-school-page">

    <!-- =====================================================
         School Information
         ===================================================== -->
    <div class="school-card">

        <div class="school-header">

            <div class="school-header-info">

                <div class="school-icon">
                    🏫
                </div>

                <div>

                    <div class="school-title-row">

                        <div class="school-title">
                            @Model.School.Name
                        </div>

                        <button type="button"
                                class="btn-edit-school"
                                id="btnEditSchool"
                                data-id="@Model.School.Id">
                            ✏️ ویرایش
                        </button>

                    </div>

                    <div class="school-subtitle">
                        اطلاعات و مدیریت مدرسه
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             School Details
             ===================================================== -->
        <div class="school-info-grid">

            <div class="info-box">
                <div class="info-icon">
                    🏫
                </div>

                <div class="info-content">
                    <span>نوع مدرسه</span>
                    <h5>
                        @Model.School.Type
                    </h5>
                </div>
            </div>


            <div class="info-box">
                <div class="info-icon">
                    👨‍🎓
                </div>

                <div class="info-content">
                    <span>جنسیت</span>
                    <h5>
                        @Model.School.Gender
                    </h5>
                </div>
            </div>


            <div class="info-box">
                <div class="info-icon">
                    🕐
                </div>

                <div class="info-content">
                    <span>شیفت</span>
                    <h5>
                        @Model.School.Shift
                    </h5>
                </div>
            </div>


            <div class="info-box">
                <div class="info-icon">
                    🎓
                </div>

                <div class="info-content">
                    <span>مقطع تحصیلی</span>
                    <h5>
                        @Model.School.EducationLevel
                    </h5>
                </div>
            </div>


            <div class="info-box">
                <div class="info-icon">
                    📚
                </div>

                <div class="info-content">
                    <span>دوره تحصیلی</span>
                    <h5>
                        @Model.School.EducationPeriod
                    </h5>
                </div>
            </div>


            <div class="info-box">
                <div class="info-icon">
                    📍
                </div>

                <div class="info-content">
                    <span>موقعیت</span>
                    <h5>
                        @Model.School.City
                    </h5>
                </div>
            </div>

        </div>

    </div>


    <!-- =====================================================
         Classes Header
         ===================================================== -->
    <div class="classes-header">

        <div class="classes-heading">

            <div class="classes-icon">
                📚
            </div>

            <div>
                <h3>
                    کلاس‌های مدرسه
                </h3>

                <span>
                    کلاس‌های ثبت شده در مدرسه
                </span>
            </div>

        </div>


        <!-- Actions -->
        <div class="classes-actions">

            <a asp-controller="SchoolManager"
               asp-action="Teachers"
               asp-route-schoolId="@Model.School.Id"
               class="btn btn-outline-primary teacher-management-btn">
                👨‍🏫 مدیریت معلم‌ها
            </a>

            <button type="button"
                    class="btn btn-success add-class-btn"
                    id="btnOpenAddClass">
                ＋ افزودن کلاس
            </button>

        </div>

    </div>


    <!-- =====================================================
         Classes
         ===================================================== -->
    @if (Model.Classes is not null && Model.Classes.Any())
    {
        <div class="row g-2">

            @foreach (var item in Model.Classes)
            {
                <div class="col-xl-4 col-lg-6 col-md-6 class-item">

                    <div class="class-card">

                        <!-- Class Header -->
                        <div class="class-card-header">

                            <div class="class-card-icon">
                                📖
                            </div>

                            <div>

                                <div class="class-name">
                                    @item.Name
                                </div>

                                <div class="class-label">
                                    کلاس
                                </div>

                            </div>

                        </div>


                        <!-- Class Details -->
                        <div class="class-details">

                            <div class="class-detail">

                                <span>
                                    پایه
                                </span>

                                <strong>
                                    @item.Grade
                                </strong>

                            </div>


                            <div class="class-detail">

                                <span>
                                    رشته
                                </span>

                                <strong>
                                    @item.Major
                                </strong>

                            </div>


                        </div>


                        <!-- Buttons -->
                        <div class="buttons">

                            <a asp-controller="SchoolManager"
                               asp-action="ClassInfo"
                               asp-route-classId="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                👁 مشاهده
                            </a>

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm btnDelete"
                                    data-id="@item.Id">
                                🗑 حذف
                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- =================================================
             Empty Classes
             ================================================= -->
        <div class="empty-classes">

            <div class="empty-icon">
                📚
            </div>

            <h4>
                هنوز کلاسی ثبت نشده است
            </h4>

            <p>
                برای شروع، اولین کلاس مدرسه را ایجاد کنید.
            </p>

            <button type="button"
                    class="btn btn-success"
                    id="btnOpenAddClass">
                ＋ افزودن اولین کلاس
            </button>

        </div>
    }

</div>


<!-- =========================================================
     Modals
     ========================================================= -->

<partial name="_AddClass.cshtml"
         model="@Model.School.Id" />

<partial name="_UpdateSchool.cshtml"
         model="@Model.School.Id" />


@section Scripts {

    <script>

        $(document).ready(function () {

            // =================================================
            // Delete Class
            // =================================================

            $(".btnDelete").on("click", function () {

                const classId = $(this).data("id");

                Swal.fire({
                    title: "حذف کلاس",
                    text: "آیا از حذف این کلاس مطمئن هستید؟",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "بله، حذف کن",
                    cancelButtonText: "انصراف",
                    reverseButtons: true
                }).then((result) => {

                    if (!result.isConfirmed)
                        return;

                    $.ajax({
                        url: "/SchoolManager/DeleteClass",
                        type: "POST",
                        data: {
                            classId: classId
                        },

                        success: function (response) {

                            if (response.success) {

                                Swal.fire({
                                    icon: "success",
                                    title: "کلاس حذف شد",
                                    text: "کلاس با موفقیت حذف شد.",
                                    confirmButtonText: "باشه"
                                }).then(() => {
                                    location.reload();
                                });

                            } else {

                                Swal.fire({
                                    icon: "error",
                                    title: "خطا",
                                    text: response.message || "حذف کلاس انجام نشد.",
                                    confirmButtonText: "باشه"
                                });

                            }

                        },

                        error: function () {

                            Swal.fire({
                                icon: "error",
                                title: "خطا",
                                text: "در ارتباط با سرور مشکلی پیش آمد.",
                                confirmButtonText: "باشه"
                            });

                        }

                    });

                });

            });

        });

    </script>
}