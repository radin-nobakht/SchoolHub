<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Views\School\SchoolPage.cshtml.css" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\Downloads\schoolhub_icon_transparent_40x40 (1).png" Link="wwwroot\image\schoolhub_icon_transparent_40x40 %281%29.png" />
